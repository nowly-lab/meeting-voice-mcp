{
  "name": "meeting-voice-mcp",
  "version": "0.1.0",
  "description": "Record meeting mic and Mac audio, transcribe on the Mac or with Gemini Live, and deliver silence-separated segments to the Claude Code session that started recording.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "meeting-voice-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "native",
    "plugin",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowly-lab/meeting-voice-mcp.git"
  },
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "prepare": "tsc && node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=60000 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "sherpa-onnx-node": "2.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
