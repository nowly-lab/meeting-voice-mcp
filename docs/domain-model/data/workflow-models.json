{
  "schema": "workflow-models/v1",
  "title": "状態の移り方",
  "checked": {
    "revision": "planned",
    "date": "2026-11-16"
  },
  "lifecycles": [
    {
      "id": "meeting-life",
      "name": "会議",
      "domain": "recording",
      "summary": "録音中の会議は1台に1つ。止めたら音声を圧縮して残す。",
      "states": [
        {
          "id": "recording",
          "name": "録音中",
          "initial": true
        },
        {
          "id": "stopped",
          "name": "止めた(圧縮中)"
        },
        {
          "id": "saved",
          "name": "保存した",
          "final": true
        }
      ],
      "transitions": [
        {
          "from": "recording",
          "on": "cmd-transcribe",
          "to": "recording"
        },
        {
          "from": "recording",
          "on": "cmd-seal",
          "to": "recording"
        },
        {
          "from": "recording",
          "on": "cmd-stop",
          "to": "stopped",
          "effect": "開いている区切りを閉じる"
        },
        {
          "from": "stopped",
          "on": "cmd-compress",
          "to": "saved"
        }
      ],
      "rejections": [
        {
          "state": "stopped",
          "on": "cmd-stop",
          "kind": "ignored",
          "reason": "もう止めた"
        },
        {
          "state": "saved",
          "on": "cmd-stop",
          "kind": "ignored",
          "reason": "もう止めた"
        },
        {
          "state": "stopped",
          "on": "cmd-transcribe",
          "kind": "ignored",
          "reason": "止めた後に届いた文字起こしは、止める前の発言なら足す"
        },
        {
          "state": "saved",
          "on": "cmd-transcribe",
          "kind": "invalid",
          "reason": "保存した会議は変わらない"
        },
        {
          "state": "stopped",
          "on": "cmd-seal",
          "kind": "ignored",
          "reason": "止めるときに閉じ終えている"
        },
        {
          "state": "saved",
          "on": "cmd-seal",
          "kind": "invalid",
          "reason": "保存した会議は変わらない"
        },
        {
          "state": "recording",
          "on": "cmd-compress",
          "kind": "invalid",
          "reason": "録音中は圧縮しない"
        },
        {
          "state": "saved",
          "on": "cmd-compress",
          "kind": "ignored",
          "reason": "もう圧縮した"
        }
      ]
    },
    {
      "id": "segment-life",
      "name": "区切り",
      "domain": "delivery",
      "summary": "区切りは一度だけ受け取られ、届いたら二度と届けない。",
      "states": [
        {
          "id": "sealed",
          "name": "閉じた(届け待ち)",
          "initial": true
        },
        {
          "id": "claimed",
          "name": "受け取られた"
        },
        {
          "id": "delivered",
          "name": "届いた",
          "final": true
        }
      ],
      "transitions": [
        {
          "from": "sealed",
          "on": "cmd-deliver",
          "to": "claimed",
          "guard": "届け先のセッションのプラグイン"
        },
        {
          "from": "claimed",
          "on": "ev-delivered",
          "to": "delivered"
        },
        {
          "from": "claimed",
          "on": "cmd-release",
          "to": "sealed",
          "guard": "受け取ってから30秒届かない",
          "effect": "再送の印をつける"
        }
      ],
      "rejections": [
        {
          "state": "claimed",
          "on": "cmd-deliver",
          "kind": "invalid",
          "reason": "別の受け取りが進んでいる"
        },
        {
          "state": "delivered",
          "on": "cmd-deliver",
          "kind": "invalid",
          "reason": "もう届いた"
        },
        {
          "state": "sealed",
          "on": "ev-delivered",
          "kind": "invalid",
          "reason": "受け取らずに届いたことにはできない"
        },
        {
          "state": "delivered",
          "on": "ev-delivered",
          "kind": "ignored",
          "reason": "二度目の届いた知らせは無視する"
        },
        {
          "state": "sealed",
          "on": "cmd-release",
          "kind": "ignored",
          "reason": "受け取られていない"
        },
        {
          "state": "delivered",
          "on": "cmd-release",
          "kind": "ignored",
          "reason": "もう届いた"
        }
      ]
    }
  ]
}
